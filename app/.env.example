# Copy this file to .env and fill in real values before deploying.

# Port the server listens on
PORT=3000

# Set to "production" once deployed behind HTTPS (enables secure cookies)
NODE_ENV=development

# Long random string used to sign session cookies — change this to something
# unique before going live. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Initial admin login, only used the very first time the server starts
# (when the database has no admin account yet). Change the password from
# the admin panel's Settings page after your first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional: override where the SQLite database and uploaded files (product
# photos, logo) live. Leave unset for local dev — they'll default to
# app/data and app/uploads. On a host with a persistent disk (Render,
# Railway), point both at subfolders of the mounted disk, e.g.:
#   DATA_DIR=/var/data/db
#   UPLOADS_DIR=/var/data/uploads
# DATA_DIR=
# UPLOADS_DIR=
